+    """The row's gold citations as [(act, article)], every one VALIDATED. Supports the smoke format
+    (expected_act / expected_article) and the questions_v0 format (gold_citations)."""
+    expected: list[tuple[str, str]] = []
+    if row.get("expected_act") or row.get("expected_article"):   # smoke format — validate too
+        expected.append(_parse_citation(f"{row.get('expected_act','')} "
+                                        f"{row.get('expected_article','')}", known_acts, lineno))
+    for g in row.get("gold_citations", []):                      # questions_v0 gold
+        expected.append(_parse_citation(g, known_acts, lineno))
+    return expected
+
+
+def _annotations(row: dict, lineno: int) -> tuple[list[str], str | None]:
+    """(gold_key_points, theme), VALIDATED here — fail-loud, not passthrough, before the generation
+    harness consumes them. retrieval_eval itself ignores the fields; carrying them through this ONE
