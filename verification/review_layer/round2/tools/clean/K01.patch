+# One candidate row shape for every channel and for the exact route: the SAME six columns, in the
+# SAME order, so `_hit` can turn any of them into a candidate dict. Written once — a column added
+# to one channel and forgotten in another is exactly how the row shapes drift apart.
+_CANDIDATE_COLUMNS = ("ci.content_hash, ci.act_nreg, ci.unit_path, ci.citation, ci.in_force_from, "
+                      "       ci.in_force_to")
+
+Hit = dict          # one candidate: the six columns above plus the caller's own score/route keys
+
+
+def _hit(row, **extra) -> Hit:
+    """One `_CANDIDATE_COLUMNS` row → a candidate dict, richest-first, with the caller's channel
+    score (`dist`/`rank`), fusion data or `route` appended after the shared keys."""
+    content_hash, act, unit_path, citation, in_force_from, in_force_to = row[:6]
+    return {"content_hash": content_hash, "act": act, "unit_path": unit_path,
+            "citation": citation, "in_force_from": in_force_from, "in_force_to": in_force_to,
+            **extra}
+
+
+def _identity(hit: Hit) -> tuple:
+    """The CITABLE identity of a candidate: (act, unit_path, in_force_from). Fusion dedups by it,
+    and so does the exact-route merge — one definition, so the two cannot disagree about what
+    counts as the same norm."""
+    return (hit["act"], hit["unit_path"], hit["in_force_from"])
