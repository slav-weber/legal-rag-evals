+def _new_run_id(backend: str) -> str:
+    """UTC timestamp to the second + backend: unique per run, so no run file is clobbered."""
+    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H%M%S") + f"_{backend}"
+
+
+def _write_jsonl(path: Path, header: dict, rows: list[dict]) -> Path:
+    """The header as the first JSON line, then one line per row (UTF-8, non-ASCII kept)."""
+    with open(path, "w", encoding="utf-8") as fh:
+        fh.write(json.dumps(header, ensure_ascii=False) + "\n")
+        for row in rows:
+            fh.write(json.dumps(row, ensure_ascii=False) + "\n")
+    return path
+
