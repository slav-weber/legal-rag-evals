+def _iter_jsonl(path: Path) -> Iterator[tuple[int, dict]]:
+    """(1-based line number, parsed row) for every non-blank line of a JSONL file. Blank lines are
+    skipped but still COUNT, so the line number in a fail-loud message points at the real line of
+    the file. The one reader for the gold files and the golden corpus alike."""
+    for lineno, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
+        if line.strip():
+            yield lineno, json.loads(line)
+
