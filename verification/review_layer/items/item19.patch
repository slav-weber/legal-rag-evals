+# The citable-identity columns every candidate query selects first, in the order the hit dicts
+# unpack them (content_hash, act, unit_path, citation, in_force_from, in_force_to).
+_HIT_COLUMNS = ("ci.content_hash, ci.act_nreg, ci.unit_path, ci.citation, ci.in_force_from, "
+                "ci.in_force_to")
+
+
+def _channel_hits(rows, score_key: str) -> list[dict]:
+    """Rows of (_HIT_COLUMNS…, channel score) → hit dicts. The channel-local score lands under
+    `score_key`: `dist` for dense (lower = closer), `rank` for fts/lemma (higher = better)."""
+    return [{"content_hash": h, "act": a, "unit_path": p, "citation": c, "in_force_from": f,
+             "in_force_to": t, score_key: float(s)} for h, a, p, c, f, t, s in rows]
+
+
