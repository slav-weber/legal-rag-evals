# === Phase L: local development, zero external cost ===

# PostgreSQL (docker compose)
POSTGRES_DB=pravo
POSTGRES_USER=pravo
POSTGRES_PASSWORD=pravo_local_dev
DATABASE_URL=postgresql://pravo:pravo_local_dev@localhost:55432/pravo

# MinIO / S3
MINIO_ROOT_USER=pravo
MINIO_ROOT_PASSWORD=pravo_local_dev
S3_ENDPOINT=http://localhost:59000
S3_BUCKET_RAW=raw-snapshots

# Store for the collected data (decision of 2026-07-04): a separate disk, outside the repository.
# The raw snapshots here are the source of truth; Postgres/MinIO are rebuildable from them.
DATA_DIR=E:/pravo-8/pravo-8-data

# Local LLM (LM Studio on the host; OpenAI-compatible API).
# Model policy v2 (2026-07-05): generation runs on DeepSeek (key below); the local
# model covers service roles, smoke runs and an offline fallback only.
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=mamaylm-gemma-3-12b-it-v1.0
EMBEDDINGS_BASE_URL=http://localhost:1234/v1
EMBEDDINGS_MODEL=text-embedding-bge-m3

# Hybrid retrieval, RRF merge. CANONICAL WEIGHTS (calibrated on the reference questions):
# DENSE=2.0 / FTS=0.5 / LEMMA=0.5 — dense parity on p@1 (correlated fts+lemma share the weight).
# These are the OPERATIVE defaults (baked into retrieval._WEIGHT_CANON); the lines below exist only
# to OVERRIDE them on a recalibration. k=60 (the standard RRF constant), top-N per channel = 50.
# RRF_K=60
# RRF_TOPN=50
# RRF_WEIGHT_DENSE=2.0
# RRF_WEIGHT_FTS=0.5
# RRF_WEIGHT_LEMMA=0.5
# RAG_DEBUG=1   # logs channel contributions, degradation and the exact-lookup route (route=exact)

# Cross-encoder reranker (bge-reranker-v2-m3), IN-PROCESS on the RTX 4080 (NOT LM Studio).
# RERANK_MODEL pins the model (mirror of EMBEDDINGS_MODEL; reference scores in
# ml/reranker_reference.json, drift → red). RERANK_TOPN = how many RRF candidates to rerank
# before the top-k cut (precision over recall).
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_TOPN=50

# DeepSeek (EXTERNAL, PAID) — enabled by the decision of 2026-07-04.
# HARD DATA RULE: PUBLIC / SYNTHETIC data only (statute texts, the public FAQ, dev fixtures).
# NEVER court-decision texts, personal names / personal data, or real user queries.
# The real key goes ONLY into .env (gitignored), never here.
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# The deepseek-chat / deepseek-reasoner aliases DIE on 2026-07-24. Default = v4-flash
# (cheap); deepseek-v4-pro only for quality-critical cross-checks.
# DEEPSEEK_MODEL=deepseek-v4-flash

# OPEN_DATA (data.gov.ua CKAN) — an OPTIONAL key that makes open-data access more reliable
# (fetch_dumps / edrnpa / probe / collect apply it via pipelines.opendata.auth_headers).
# The real value goes ONLY into .env (gitignored), never here; it is never written to the logs.
# OPEN_DATA_API_KEY=...
